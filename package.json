{
  "name": "vibecodereview",
  "version": "1.11.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Multi-model pull request review with a GitHub Action, local CLI, MCP tool, provider routing, and optional chair fix commits.",
  "type": "module",
  "bin": {
    "vibecodereview": "bin/vibecodereview.mjs"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs && npm run selfcheck",
    "selfcheck": "node scripts/council-review.mjs --selfcheck",
    "mcp": "node mcp/server.mjs"
  },
  "files": [
    "action.yml",
    "scripts/",
    "bin/",
    "mcp/",
    "skills/",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/vibecodereview.git"
  },
  "license": "MIT",
  "keywords": [
    "code-review",
    "pull-request",
    "GitHub Actions",
    "mcp",
    "cli",
    "OpenAI",
    "Google Gemini",
    "Moonshot AI",
    "OpenRouter",
    "Claude Code",
    "Devin",
    "Cursor",
    "Grok",
    "multi-model",
    "review-automation"
  ]
}
